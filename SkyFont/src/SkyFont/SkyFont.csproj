<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkyFont</AssemblyName>
    <RootNamespace>SkyFont</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\SkyFont.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>SkyFont</Product>
    <Company>SkyFont Project</Company>
    <Description>Windows 字体管理器 — 预览、激活与反激活 TrueType / OpenType 字体</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    单文件打包相关设置。

    这些属性只在「指定了 RuntimeIdentifier」时生效，也就是 `dotnet publish -r win-x64`
    或 Visual Studio 的发布配置文件（Properties\PublishProfiles\win-x64.pubxml）。
    日常 `dotnet build` / VS 的「生成」不受影响，避免拖慢调试构建。
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

</Project>
